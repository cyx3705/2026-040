{
  "manifest_version": 3,
  "name": "Echo 英语伴读",
  "version": "0.1.0",
  "description": "使用本机 Echo 为网页英文逐词选义，点击标熟，学会的词不再翻译。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8040/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Echo 英语伴读"}
}
